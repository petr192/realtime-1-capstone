{
  "uid": "capstone",
  "title": "Operations and Recovery",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests",
      "type": "stat",
      "targets": [
     {
      "refId": "A",
      "expr": "sum(rate(capstone_http_requests_total[5m]))",
      "legendFormat": "requests/s"
     }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "API 5xx rate",
      "type": "stat",
      "targets": [
      {
      "refId": "A",
      "expr": "sum(rate(capstone_http_requests_total{status=~\"5..\"}[5m]))",
      "legendFormat": "5xx/s"
       }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "type": "timeseries",
      "targets": [
      {
      "refId": "A",
      "expr": "histogram_quantile(0.95, sum by (le) (rate(capstone_http_duration_seconds_bucket[5m])))",
      "legendFormat": "p95"
      }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Отставание по partitions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Разность offsets. При отсутствии commit отсчёт от начала доступного журнала.",
      "targets": [
        {
          "refId": "A",
          "expr": "demo_kafka_lag",
          "legendFormat": "partition {{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Скорость поступления и commit",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Оценка продвижения offsets/с за 30с, включая probes и маркеры. Это не число бизнес-заказов.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(deriv(demo_kafka_log_end[30s]),0))",
          "legendFormat": "Вход"
        },
        {
          "refId": "B",
          "expr": "sum(clamp_min(deriv(demo_kafka_committed[30s]),0))",
          "legendFormat": "Commit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Возраст недоставленного probe",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Алерт: >10с в течение 10с. Pending учитывает события, которых пока нет в API.",
      "targets": [
        {
          "refId": "A",
          "expr": "demo_probe_oldest_seconds",
          "legendFormat": "Самое старое ожидание"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Сквозная задержка доставленных probes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Окно 2м, включает polling. Незавершённые проверки смотрите слева, они не входят в гистограмму.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(demo_probe_delivery_seconds_bucket[2m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(demo_probe_delivery_seconds_bucket[2m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Задержки HTTP",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(demo_http_duration_seconds_bucket{route=\"/demo/metrics\"}[2m])))",
          "legendFormat": "p95 метрик"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Ошибки API и ingestion",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ошибки consumer хранятся в ограниченном массиве. Значение может уменьшаться; это не монотонный счётчик.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_http_requests_total{status=~\"5..\"}[30s]))",
          "legendFormat": "5xx/с"
        },
        {
          "refId": "B",
          "expr": "demo_ingestion_errors",
          "legendFormat": "Ошибки в истории consumer"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Сохранённые позиции",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "demo_kafka_log_end",
          "legendFormat": "Конец p{{partition}}"
        },
        {
          "refId": "B",
          "expr": "demo_kafka_committed",
          "legendFormat": "Commit p{{partition}}"
        },
        {
          "refId": "C",
          "expr": "demo_kafka_earliest",
          "legendFormat": "Начало p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Активные алерты",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Подробности и runbook_url: http://localhost:19007/alerts. При отсутствии активных алертов No data.",
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "Свободный диск ClickHouse",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Свободное место файловой системы контейнера; Kafka имеет собственные ограничения retention/размера.",
      "targets": [
        {
          "refId": "A",
          "expr": "demo_clickhouse_free_bytes",
          "legendFormat": "Свободно"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Parts таблицы orders_current_t в ClickHouse",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Количество активных parts таблицы orders. Большое число parts замедляет чтение.",
      "targets": [
        {
          "refId": "A",
          "expr": "capstone_clickhouse_parts_total{table=\"orders_current_t\"}",
          "legendFormat": "parts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 14,
      "title": "Наблюдатель и незавершённые проверки",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - demo_monitor_last_cycle_unixtime",
          "legendFormat": "Возраст измерения, с"
        },
        {
          "refId": "B",
          "expr": "demo_probe_pending",
          "legendFormat": "Ожидают"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Метрики заказов",
      "url": "http://localhost:18000",
      "targetBlank": true
    },
    {
      "title": "Алерты",
      "url": "http://localhost:19004/alerts",
      "targetBlank": true
    },
    {
      "title": "Ранбук",
      "url": "http://localhost:18007/runbook",
      "targetBlank": true
    }
  ]
}
